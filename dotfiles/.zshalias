# ─────────────────────────────────────────────────────────────────────────────
# Aliases
# ─────────────────────────────────────────────────────────────────────────────

## Compiler
# MAKEJOBS=$(nproc)
# alias make="make -j$MAKEJOBS"
# alias ninja="ninja -j$MAKEJOBS"
# alias n="ninja"
## System Management
alias update="sudo pacman -Syu"
alias fixpacman="sudo rm /var/lib/pacman/db.lck"
alias rmpkg="sudo pacman -Rsn"
alias cleanch="sudo pacman -Scc"
# alias cleanup="sudo pacman -Rsn $(pacman -Qtdq)"
alias mirror="sudo cachyos-rate-mirrors"
alias grubup="sudo grub-mkconfig -o /boot/grub/grub.cfg"

## Arch Help
alias apt="man pacman"
alias apt-get="man pacman"
alias please="sudo"

## Info + Debug
alias jctl="journalctl -p 3 -xb"
alias rip="expac --timefmt='%Y-%m-%d %T' '%l\t%n %v' | sort | tail -200 | nl"
alias tb="nc termbin.com 9999"
alias big="expac -H M '%m\t%n' | sort -h | nl"
alias gitpkg='pacman -Q | grep -i "\-git" | wc -l'
alias hw='hwinfo --short'
alias psmem='ps auxf | sort -nr -k 4'
alias psmem10='ps auxf | sort -nr -k 4 | head -10'

## File Management
alias tarnow='tar -acf '
alias untar='tar -zxvf '
alias wget='wget -c '

## Navigation
alias c="clear"
alias ..='cd ..'
alias ..2='cd ../..'
alias ..3='cd ../../..'
alias ..4='cd ../../../..'
alias ..5='cd ../../../../..'

## Safer ls with eza
alias ls='eza --icons=always --no-time --no-user --no-permissions --color=always --long -G --git --no-filesize'
alias lsnew='eza --icons=always --no-time --no-user --no-permissions --color=always --long -G --git --no-filesize -s newest -r'
alias lsold='eza --icons=always --no-time --no-user --no-permissions --color=always --long -G --git --no-filesize -s newest'
alias la='eza -a --color=always --group-directories-first --icons'
alias ll='eza -l --color=always --group-directories-first --icons'
alias lt='eza -aT --color=always --group-directories-first --icons'
alias l.='eza -a | grep -e "^\."'

## Core utils with color
alias dir='dir --color=auto'
alias vdir='vdir --color=auto'
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'


# Visual Studio Code (wayland)
alias code='code --enable-features=UseOzonePlatform --ozone-platform=wayland'


# rclone
alias rc="rclone"
alias rcm='rclone mount --vfs-cache-mode full --vfs-cache-max-size 10G --vfs-cache-max-age 24h --bwlimit-file 10M --dir-cache-time 72h --buffer-size 128M --poll-interval 15s --daemon --allow-other'
alias rcu='fusermount -u'
alias rcls='rclone ls'
alias rclsl='rclone lsl'
alias rclsd='rclone lsd'
alias rclr='rclone listremotes'

# config files
alias nvc="nvim ~/.config/nvim/"

# neovim
alias nv="nvim"

# git
# alias gs="git status"
# alias ga="git add"
# alias gcm="git commit -m"
# alias gp="git push"

# yt-dlp
alias yta-aac="yt-dlp --extract-audio --audio-format aac "
alias yta-best="yt-dlp --extract-audio --audio-format best "
alias yta-flac="yt-dlp --extract-audio --audio-format flac "
alias yta-m4a="yt-dlp --extract-audio --audio-format m4a "
alias yta-mp3="yt-dlp --extract-audio --audio-format mp3 "
alias yta-opus="yt-dlp --extract-audio --audio-format opus "
alias yta-vorbis="yt-dlp --extract-audio --audio-format vorbis "
alias yta-wav="yt-dlp --extract-audio --audio-format wav "
alias ytv-best="yt-dlp -f bestvideo+bestaudio "
alias ytv-best-mp4="yt-dlp -f 'bestvideo[ext=mp4]+bestaudio[ext=m4a]/bestvideo+bestaudio' "
alias ytv-best-webm="yt-dlp -f 'bestvideo[ext=webm]+bestaudio[ext=webm]/bestvideo+bestaudio' "
alias ytv-best-all="yt-dlp -f 'bestvideo+bestaudio' "
alias ytv-best-all-mp4="yt-dlp -f 'bestvideo[ext=mp4]+bestaudio[ext=m4a]/bestvideo+bestaudio' "
alias ytv-best-all-webm="yt-dlp -f 'bestvideo[ext=webm]+bestaudio[ext=webm]/bestvideo+bestaudio' "

# switcheroo
alias switchnvidia="switcherooctl -g 1"

# rsync
alias rsn="rsync --progress -r"

# paru
alias paru="paru --topdown --limit 10"


# zoxide
alias cd="z"


